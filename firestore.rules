rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires firebase-tools and `firebase use <project-id>` first)
//
// This app has no login — the bar list is a single open, shared document by
// design. Previously this project had no rules file checked into the repo at
// all, so the Firebase console default applied to every collection in the
// project, not just the ones this app actually uses. This scopes public
// read/write down to exactly those collections/docs instead.
//
// The size caps below don't add auth (there isn't any) — they just stop a
// single write from ballooning storage/bandwidth cost, since every write to
// the shared doc replaces a whole array field.
service cloud.firestore {
  match /databases/{database}/documents {

    // The single shared document holding every bar, ranking battle, and
    // achievement unlock.
    match /tourDeAlcoholism/sharedList {
      allow read: if true;
      allow write: if true
        && (!('bars' in request.resource.data)
            || (request.resource.data.bars is list && request.resource.data.bars.size() <= 500))
        && (!('rankingBattles' in request.resource.data)
            || (request.resource.data.rankingBattles is list && request.resource.data.rankingBattles.size() <= 5000))
        && (!('achievementUnlocks' in request.resource.data)
            || (request.resource.data.achievementUnlocks is list && request.resource.data.achievementUnlocks.size() <= 500));
    }

    // Shared 24h cache of Google Places search results (also written
    // server-side via the REST API with no auth header — this must stay
    // open for that to work).
    match /placesSearchCache/{docId} {
      allow read: if true;
      allow write: if true
        && (!('places' in request.resource.data)
            || (request.resource.data.places is list && request.resource.data.places.size() <= 50));
    }

    // Everything else in the project is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
